# Copia este archivo como .env y completa tus datos (el .env no se sube a git).

DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/malignosbarber_db

# Clave para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=7d

PORT=3000
# URL de la app React (para CORS y para el enlace de cancelación en los emails).
CLIENT_URL=http://localhost:5173

# Zona horaria de la barbería (nombre IANA).
ZONA_HORARIA=America/El_Salvador

# Agenda pública
INTERVALO_AGENDA_MIN=15
DIAS_MAX_AGENDA=60
MAX_CITAS_ACTIVAS=2

# Recordatorios por email: horas antes de la cita, separadas por coma.
RECORDATORIOS_HORAS_ANTES=24,2
# Sin SMTP_HOST los recordatorios se guardan pero no se envían.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una
# "contraseña de aplicación" de Google en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Malignos Barber <tu-correo@ejemplo.com>"
