# Opcional. En desarrollo no hace falta: Vite redirige /api a http://localhost:3000.
# En producción, la URL pública de la API:
# VITE_API_URL=https://api.tu-dominio.com/api

# Zona horaria de la barbería (la misma que ZONA_HORARIA en bck/.env).
VITE_ZONA_HORARIA=America/El_Salvador

# Símbolo de moneda que se muestra en precios y reportes.
VITE_SIMBOLO_MONEDA=$
